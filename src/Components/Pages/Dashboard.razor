@page "/"
@implements IDisposable
@inject PipelineProgressService ProgressService

<div class="dashboard">
    @if (ProgressService.TotalCount == 0)
    {
        <div class="waiting-card">
            <div class="spinner"></div>
            <h2>Waiting for pipelines…</h2>
            <p>The conversion will start momentarily. Pipeline status will appear here in real time.</p>
        </div>
    }
    else
    {
        <!-- Summary bar -->
        <div class="summary">
            <div class="summary-stat">
                <span class="stat-value">@ProgressService.TotalCount</span>
                <span class="stat-label">Total</span>
            </div>
            <div class="summary-stat completed">
                <span class="stat-value">@ProgressService.CompletedCount</span>
                <span class="stat-label">Completed</span>
            </div>
            @if (ProgressService.FailedCount > 0)
            {
                <div class="summary-stat failed">
                    <span class="stat-value">@ProgressService.FailedCount</span>
                    <span class="stat-label">Failed</span>
                </div>
            }
            @if (ProgressService.IsComplete)
            {
                <div class="summary-stat">
                    <span class="stat-value">@FormatDuration(ProgressService.TotalElapsed)</span>
                    <span class="stat-label">Elapsed</span>
                </div>
            }
            else
            {
                <div class="summary-stat processing">
                    <span class="stat-value"><span class="dots-loader"></span></span>
                    <span class="stat-label">Processing</span>
                </div>
            }
        </div>

        <!-- Overall progress bar -->
        <div class="progress-container">
            <div class="progress-bar">
                <div class="progress-fill @(ProgressService.IsComplete ? "done" : "")"
                     style="width: @ProgressPercent()%">
                    @if (!ProgressService.IsComplete)
                    {
                        <div class="progress-shimmer"></div>
                    }
                </div>
            </div>
            <span class="progress-text">
                @(ProgressService.CompletedCount + ProgressService.FailedCount) / @ProgressService.TotalCount
                @if (ProgressService.IsComplete)
                {
                    <text> — Done!</text>
                }
            </span>
        </div>

        <!-- Pipeline cards -->
        <div class="pipeline-grid">
            @foreach (var entry in ProgressService.GetAll())
            {
                var isActive = IsActivePhase(entry.Phase);
                var isDone = entry.Phase is ProcessingPhase.Complete or ProcessingPhase.Failed;

                <div class="pipeline-card @PhaseClass(entry.Phase)">
                    <div class="card-header">
                        @if (isActive)
                        {
                            <span class="card-spinner"></span>
                        }
                        else
                        {
                            <span class="card-icon">@PhaseIcon(entry.Phase)</span>
                        }
                        <span class="card-name" title="@entry.Pipeline.FilePath">
                            @System.IO.Path.GetFileName(entry.Pipeline.FilePath)
                        </span>
                        <span class="source-badge @entry.Pipeline.SourceType.ToString().ToLowerInvariant()">
                            @entry.Pipeline.SourceType
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="card-phase">@PhaseLabel(entry.Phase)</div>
                        @if (isDone)
                        {
                            <div class="card-elapsed">@FormatDuration(entry.Elapsed)</div>
                        }
                        else if (isActive)
                        {
                            <div class="card-activity">
                                <span class="pulse-dot"></span>
                                <span class="pulse-dot"></span>
                                <span class="pulse-dot"></span>
                            </div>
                        }
                    </div>
                    @if (entry.Phase == ProcessingPhase.Failed && !string.IsNullOrEmpty(entry.Message))
                    {
                        <div class="card-error">@entry.Message</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private Timer? _timer;

    protected override void OnInitialized()
    {
        // Simple polling every 500ms — works reliably across all Blazor render modes
        _timer = new Timer(OnPoll, null, 0, 500);
    }

    private async void OnPoll(object? state)
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private int ProgressPercent()
    {
        if (ProgressService.TotalCount == 0) return 0;
        return (int)((ProgressService.CompletedCount + ProgressService.FailedCount) * 100.0 / ProgressService.TotalCount);
    }

    private static bool IsActivePhase(ProcessingPhase phase) =>
        phase is ProcessingPhase.Starting or ProcessingPhase.Converting
              or ProcessingPhase.Validating or ProcessingPhase.Writing;

    private static string PhaseIcon(ProcessingPhase phase) => phase switch
    {
        ProcessingPhase.ConversionComplete => "✅",
        ProcessingPhase.ValidationComplete => "✅",
        ProcessingPhase.Complete => "✅",
        ProcessingPhase.Failed => "❌",
        _ => "…"
    };

    private static string PhaseLabel(ProcessingPhase phase) => phase switch
    {
        ProcessingPhase.Starting => "Starting…",
        ProcessingPhase.Converting => "Converting…",
        ProcessingPhase.ConversionComplete => "Conversion complete",
        ProcessingPhase.Validating => "Validating…",
        ProcessingPhase.ValidationComplete => "Validation complete",
        ProcessingPhase.Writing => "Writing output…",
        ProcessingPhase.Complete => "Complete",
        ProcessingPhase.Failed => "Failed",
        _ => "Unknown"
    };

    private static string PhaseClass(ProcessingPhase phase) => phase switch
    {
        ProcessingPhase.Complete => "phase-complete",
        ProcessingPhase.Failed => "phase-failed",
        ProcessingPhase.Converting or ProcessingPhase.Validating or ProcessingPhase.Writing => "phase-active",
        ProcessingPhase.Starting => "phase-starting",
        _ => ""
    };

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1) return ts.ToString(@"h\:mm\:ss");
        if (ts.TotalMinutes >= 1) return ts.ToString(@"m\:ss");
        return $"{ts.TotalSeconds:F1}s";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
